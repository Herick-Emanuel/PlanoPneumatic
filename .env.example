APP_PORT=3000
POSTGRES_DB=plano_pneumatic
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
SEED_ADMIN_EMAIL=admin@planopneumatic.com
SEED_ADMIN_PASSWORD=Admin123!
SEED_ADMIN_NAME=Administrador
SEED_OPERATOR_EMAIL=operador@planopneumatic.com
SEED_OPERATOR_PASSWORD=Operador123!
SEED_OPERATOR_NAME=Operador de Triagem

# Integracao Omie (opcional): chaves em Omie > Configuracoes > Integracoes > Aplicativos (app_key / app_secret)
OMIE_APP_KEY=
OMIE_APP_SECRET=
OMIE_SYNC_INTERVAL_HOURS=24

# E-mail por SMTP (recuperacao de senha, convites, avisos e relatorios agendados).
# Sem SMTP_HOST nada e enviado. Porta 465 usa TLS direto; 587 usa STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=PlanoPneumatic <no-reply@SEU-DOMINIO>
# Endereco que vai nos links dos e-mails (padrao: FRONTEND_ORIGIN)
APP_PUBLIC_URL=

# WhatsApp Cloud API da Meta (opcional; cada pessoa liga o canal em Minha conta).
# O modelo (template) precisa estar aprovado na Meta, com um parametro no corpo.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=aviso_processo
WHATSAPP_TEMPLATE_LANG=pt_BR

# Rastreamento de erros (opcional): DSN do projeto no Sentry
SENTRY_DSN=
SENTRY_ENVIRONMENT=

# Antivirus dos anexos (opcional): endereco do clamd (servico "clamav" do docker compose, perfil antivirus)
CLAMAV_HOST=
CLAMAV_PORT=3310
