# Copie para .env e preencha. O .env nunca vai para o Git (veja .gitignore).
APP_PORT=3000
POSTGRES_DB=plano_pneumatic
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Primeiro administrador (criado na primeira subida). Obrigatorio: senha forte com 12+ caracteres,
# diferente dos exemplos. No primeiro login o sistema pede para trocar a senha.
SEED_ADMIN_EMAIL=admin@planopneumatic.com
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Administrador
# Operador de demonstracao (opcional): so e criado se a senha for preenchida.
SEED_OPERATOR_EMAIL=operador@planopneumatic.com
SEED_OPERATOR_PASSWORD=
SEED_OPERATOR_NAME=Operador de Triagem

# Opcional em desenvolvimento (obrigatoria em producao): cifra segredos de webhook e de MFA no banco.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=

# Integracao Omie (opcional): chaves em Omie > Configuracoes > Integracoes > Aplicativos (app_key / app_secret).
# Nunca coloque chaves reais neste arquivo de exemplo.
OMIE_APP_KEY=
OMIE_APP_SECRET=
OMIE_SYNC_INTERVAL_HOURS=24
# Espelho de pedidos e notas: busca o que mudou a cada N minutos (o webhook cobre o tempo real entre elas).
OMIE_MIRROR_INTERVAL_MINUTES=10
# Webhook (tempo real): o token NAO vem do Omie; voce cria (texto longo e aleatorio) e coloca aqui. Depois,
# no Portal do Desenvolvedor do Omie (developer.omie.com.br, perfil administrador) > seu aplicativo > Webhooks >
# adicionar, cadastre a URL publica https://<seu-app>/api/omie/webhook/<token>, com os eventos de Pedido de
# venda, NF-e, Produto e Cliente. Precisa ser o endereco publicado (localhost nao recebe). Sem token, so a
# busca periodica atualiza o espelho.
OMIE_WEBHOOK_TOKEN=

# E-mail por SMTP (recuperacao de senha, convites, avisos e relatorios agendados).
# Sem SMTP_HOST nada e enviado. Porta 465 usa TLS direto; 587 usa STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=PlanoPneumatic <no-reply@SEU-DOMINIO>
# Endereco que vai nos links dos e-mails (padrao: FRONTEND_ORIGIN)
APP_PUBLIC_URL=

# WhatsApp Cloud API da Meta (opcional; cada pessoa liga o canal em Minha conta).
# O modelo (template) precisa estar aprovado na Meta, com um parametro no corpo.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=aviso_processo
WHATSAPP_TEMPLATE_LANG=pt_BR

# Rastreamento de erros (opcional): DSN do projeto no Sentry
SENTRY_DSN=
SENTRY_ENVIRONMENT=

# Antivirus dos anexos (opcional): endereco do clamd (servico "clamav" do docker compose, perfil antivirus)
CLAMAV_HOST=
CLAMAV_PORT=3310
