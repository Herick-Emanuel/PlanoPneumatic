NODE_ENV=production
PORT=<railway-provided-port>
HOST=0.0.0.0
# OBRIGATORIAS em producao (https, sem barra no final): enderecos publicos do site e da API
FRONTEND_ORIGIN=https://planopneumatic-production.up.railway.app
API_PUBLIC_URL=https://URL-PUBLICA-DA-API
DATABASE_URL=<railway-postgres-connection>
# Obrigatoria: chave de 32 bytes para cifrar segredos de webhook e de MFA. Gere uma vez e guarde bem:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=<chave-base64-de-32-bytes>
# Mesmo valor no servico da API e no do frontend (Nginx): a API so aceita o IP informado pelo Nginx com ele.
# Gere com: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
PROXY_SHARED_SECRET=<segredo-hex>
# Saltos de proxy na frente da API (Railway = 1). Ver docs/seguranca.md.
TRUST_PROXY=1
SESSION_DURATION_DAYS=1
SESSION_IDLE_MINUTES=120
# So usados se a tabela de usuarios estiver vazia (primeira subida); remova depois. A senha precisa ser forte
# (12+ caracteres, fora das listas de senhas comuns) e e trocada obrigatoriamente no primeiro login.
SEED_ADMIN_EMAIL=<production-admin-email>
SEED_ADMIN_PASSWORD=
# Servico do frontend (Nginx)
API_UPSTREAM_URL=https://planopneumaticapi-production.up.railway.app

# Integracao Omie (opcional): chaves em Omie > Configuracoes > Integracoes > Aplicativos (app_key / app_secret)
OMIE_APP_KEY=
OMIE_APP_SECRET=
OMIE_SYNC_INTERVAL_HOURS=24

# Opcional: habilita GET /api/metrics (Authorization: Bearer <token>)
METRICS_TOKEN=
# Retencao do registro de navegacao (LGPD), em dias
ACTIVITY_RETENTION_DAYS=90

# E-mail por SMTP (recuperacao de senha, convites, avisos e relatorios agendados).
# Sem SMTP_HOST nada e enviado. Porta 465 usa TLS direto; 587 usa STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=PlanoPneumatic <no-reply@SEU-DOMINIO>
# Endereco que vai nos links dos e-mails (padrao: FRONTEND_ORIGIN)
APP_PUBLIC_URL=

# WhatsApp Cloud API da Meta (opcional; cada pessoa liga o canal em Minha conta).
# O modelo (template) precisa estar aprovado na Meta, com um parametro no corpo.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=aviso_processo
WHATSAPP_TEMPLATE_LANG=pt_BR

# Rastreamento de erros (opcional): DSN do projeto no Sentry
SENTRY_DSN=
SENTRY_ENVIRONMENT=

# Antivirus dos anexos (opcional): endereco do clamd (servico "clamav" do docker compose, perfil antivirus)
CLAMAV_HOST=
CLAMAV_PORT=3310
